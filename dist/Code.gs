// Compleet scorebord: geen apart HTML-bestand nodig.
const AOS_HTML = "<!doctype html>\n<html lang=\"nl\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Age of Sigmar · Scorebord</title><meta name=\"description\" content=\"Houd Command Points, Army Points en Victory Points bij voor twee spelers.\"><link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23121b25'/%3E%3Ctext x='32' y='45' text-anchor='middle' font-size='42' fill='%23ddba72'%3E⚔%3C/text%3E%3C/svg%3E\"><style>\n:root{color-scheme:dark;font-family:system-ui,sans-serif;background:#101720;color:#eeeae2}*{box-sizing:border-box}body{margin:0}main{max-width:1080px;margin:auto;padding:38px 24px}header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-bottom:28px;border-bottom:1px solid #34404d}.eyebrow{color:#d5b478;letter-spacing:.2em;font-size:14px;font-weight:700}h1{font-family:Georgia,serif;font-size:clamp(28px,5vw,44px);margin:8px 0 0;font-weight:normal}button,a,input{font:inherit}button{cursor:pointer;border:1px solid #4b5866;background:#25313e;color:inherit;border-radius:8px;min-height:44px;padding:9px 15px}button:hover{background:#354459}button:disabled{opacity:.4;cursor:default}a{color:#e2bd7c}#status{font-size:14px;line-height:1.5;color:#b9c5d1;margin:20px 0}#status.error{color:#ffa79f}.players{display:grid;grid-template-columns:1fr 1fr;gap:22px}.player{background:#18232f;border:1px solid #374657;border-top:3px solid var(--accent);border-radius:12px;overflow:hidden;padding:25px;--accent:#83b4e1}.player:nth-child(2){--accent:#e4a17e}.playerhead{display:flex;align-items:center;gap:12px;margin-bottom:24px}.badge{color:var(--accent);font-size:14px;border:1px solid var(--accent);border-radius:50%;width:32px;height:32px;display:grid;place-items:center}.name{width:100%;font-family:Georgia,serif;font-size:26px;color:var(--accent);border:0;background:transparent;min-width:0;padding:8px 0}.score{border-top:1px solid #33404e;padding-top:20px;margin-top:20px}.label{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;color:#c5cfda;font-size:16px}.label small{font-size:14px;color:#7c91a6}.counter{display:flex;align-items:center;gap:14px}.counter button{width:52px;height:52px;font-size:28px;padding:0;background:#263544}.value{font-size:42px;width:100%;min-width:0;text-align:center;background:transparent;color:#fff;border:1px solid transparent;border-radius:6px;font-weight:650;font-variant-numeric:tabular-nums;appearance:textfield}.value::-webkit-inner-spin-button{appearance:none}.score:last-child .value{color:#e4c17e}.value:focus,.name:focus{outline:2px solid var(--accent)}.footer{display:flex;justify-content:space-between;gap:16px;align-items:center;margin:25px 0;color:#8193a6;font-size:14px}details{border:1px solid #344252;border-radius:10px;padding:18px;background:#141f2b}summary{cursor:pointer;font-size:16px;color:#d6bd92}.setup{line-height:1.7;color:#c6d0da;font-size:16px}.setup input{background:#101720;border:1px solid #526070;border-radius:6px;padding:12px;width:100%;color:white;margin:10px 0}.setup ol{padding-left:22px}.setup li{margin:10px 0}.setup button{background:#dcc08a;color:#17202a;border:none;font-weight:650}#connected{display:none;width:100%;height:900px;border:0}body.embedded main{padding-top:20px}body.embedded details{display:none}body.embedded header a{display:none}body.linked main>.players,body.linked main>.footer{display:none}body.linked #connected{display:block}body.linked header{display:none}body.linked main{max-width:1200px;padding:0 12px}.hint{font-size:14px;color:#96a7ba}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #e7c586;outline-offset:3px}@media(max-width:640px){main{padding:24px 14px}.players{gap:12px}.player{padding:15px 12px}.playerhead{gap:8px}.name{font-size:21px}.badge{width:26px;height:26px;flex-shrink:0}.counter{gap:5px}.counter button{width:42px;height:46px;flex-shrink:0}.value{font-size:32px}.label{font-size:14px}.label small{display:none}header{align-items:flex-start}header a{font-size:14px}#connected{height:1000px}}@media(max-width:370px){.players{grid-template-columns:1fr}}\n</style></head><body><main><header><div><div class=\"eyebrow\">AGE OF SIGMAR</div><h1>Het slagveld in cijfers</h1></div><a href=\"https://docs.google.com/spreadsheets/d/143a0UmHPdKndutN8NJ8dixGCeOJRQaPuKb50I3Caj9Y/edit\" target=\"_blank\" rel=\"noopener\">Open Google Sheet ↗</a></header><p id=\"status\" role=\"status\" aria-live=\"polite\">Voorbeeldmodus · Google Sheet is nog niet gekoppeld.</p><section class=\"players\" aria-label=\"Scores voor twee spelers\"></section><div class=\"footer\"><span>Voer een score in of gebruik − en +.</span><button id=\"retry\" hidden>Opnieuw proberen</button></div><iframe id=\"connected\" title=\"Scorebord gekoppeld aan Google Sheets\" referrerpolicy=\"no-referrer\"></iframe><details id=\"connection\"><summary>Google Sheet koppelen</summary><div class=\"setup\"><p>Deze app gebruikt jouw Sheet. Rond één keer de koppeling af; daarna worden scorewijzigingen automatisch opgeslagen.</p><ol><li>Open jouw Sheet en kies <strong>Extensies → Apps Script</strong>.</li><li>Vervang de inhoud van <strong>Code.gs</strong> door <a href=\"Code.gs\" download>dit koppelingsscript</a>. Het volledige scorebord zit in dit ene bestand; een apart HTML-bestand is niet nodig.</li><li>Kies bij een bestaande koppeling <strong>Implementeren → Implementaties beheren → Bewerken → Nieuwe versie</strong>. Voor een nieuwe koppeling kies je <strong>Implementeren → Nieuwe implementatie → Web-app</strong>. Uitvoeren als: <strong>Ik</strong>. Toegang: <strong>Iedereen met een Google-account</strong>. Geef Google toestemming en kopieer de web-app-URL die eindigt op <strong>/exec</strong>.</li><li>Plak de URL hieronder en kies Koppelen. De bestaande inhoud van je Sheet blijft staan; scores komen in een apart tabblad <strong>AoS Scorebord</strong>.</li></ol><label for=\"url\">Google-web-app-URL</label><input id=\"url\" type=\"url\" placeholder=\"https://script.google.com/macros/s/…/exec\"><button id=\"link\">Koppelen</button><p class=\"hint\">De twee spelers gebruiken samen één scorebord. Gebruik de Google-web-app-URL rechtstreeks als Google in het ingebedde venster geen toegang geeft. Iedereen aan wie je die URL geeft en die inlogt, kan de scores wijzigen.</p></div></details></main><script>\nconst metrics=[['Command Points','CP','command'],['Army Points','AP','army'],['Victory Points','VP','victory']];\nlet state={players:[{name:'Speler 1',command:0,army:0,victory:0},{name:'Speler 2',command:0,army:0,victory:0}]};let pending=[],busy=false,failed=false;\nconst live=typeof google!=='undefined'&&google.script&&google.script.run;\nconst status=document.querySelector('#status');const retry=document.querySelector('#retry');\nfunction message(text,error=false){status.textContent=text;status.classList.toggle('error',error)}\nfunction render(){const root=document.querySelector('.players');root.replaceChildren();state.players.forEach((p,i)=>{const card=document.createElement('article');card.className='player';const head=document.createElement('div');head.className='playerhead';const badge=document.createElement('span');badge.className='badge';badge.textContent=i+1;const name=document.createElement('input');name.className='name';name.value=p.name;name.maxLength=60;name.setAttribute('aria-label','Naam speler '+(i+1));name.addEventListener('change',()=>{p.name=name.value.trim()||'Speler '+(i+1);if(/^[=+\\-@]/.test(p.name)){message('Gebruik een gewone spelersnaam.',true);return}name.value=p.name;queue(i,'name',p.name)});head.append(badge,name);card.append(head);metrics.forEach(([label,short,key])=>{const row=document.createElement('div');row.className='score';row.innerHTML='<div class=\"label\"><span>'+label+'</span><small>'+short+'</small></div>';const counter=document.createElement('div');counter.className='counter';const value=document.createElement('input');value.className='value';value.type='number';value.min=0;value.max=1000000;value.step=1;value.value=p[key];value.setAttribute('aria-label',label+' speler '+(i+1));const minus=document.createElement('button'),plus=document.createElement('button');minus.textContent='−';plus.textContent='+';minus.setAttribute('aria-label',label+' verlagen voor speler '+(i+1));plus.setAttribute('aria-label',label+' verhogen voor speler '+(i+1));function set(n){if(!Number.isSafeInteger(n)||n<0||n>1000000){value.value=p[key];return}p[key]=n;value.value=n;minus.disabled=n===0;plus.disabled=n===1000000;queue(i,key,n)}minus.disabled=p[key]===0;minus.onclick=()=>set(p[key]-1);plus.onclick=()=>set(p[key]+1);value.onchange=()=>set(Number(value.value));counter.append(minus,value,plus);row.append(counter);card.append(row)});root.append(card)})}\nfunction queue(player,key,value){if(!live){message('Voorbeeldmodus · wijzigingen worden nog niet in je Sheet opgeslagen.');return}pending.push({player,key,value,id:crypto.randomUUID()});message('Opslaan in Google Sheet…');pump()}\nfunction pump(){if(busy||failed||!pending.length)return;busy=true;const change=pending[0];google.script.run.withSuccessHandler(()=>{pending.shift();busy=false;if(pending.length)pump();else message('Opgeslagen in Google Sheet · '+new Date().toLocaleTimeString('nl-NL',{hour:'2-digit',minute:'2-digit'}))}).withFailureHandler(()=>{busy=false;failed=true;retry.hidden=false;message('Opslaan mislukt. Je wijzigingen staan nog klaar; probeer opnieuw.',true)}).updateScore(change)}\nretry.onclick=()=>{failed=false;retry.hidden=true;pump()};\nrender();if(live){document.body.classList.add('embedded');message('Scores ophalen uit Google Sheet…');document.querySelectorAll('.players input,.players button').forEach(e=>e.disabled=true);google.script.run.withSuccessHandler(data=>{state=data;render();message('Gekoppeld aan Google Sheet · wijzigingen worden automatisch opgeslagen.')}).withFailureHandler(()=>{message('De Sheet kan niet worden geopend. Controleer je Google-toegang en herlaad de pagina.',true)}).getScores()}\nfunction connect(url){if(!/^https:\\/\\/script\\.google\\.com\\/macros\\/s\\/[A-Za-z0-9_-]+\\/exec$/.test(url)){message('Gebruik de Google-web-app-URL die eindigt op /exec.',true);return}document.querySelector('#connected').src=url;document.body.classList.add('linked');message('Het gekoppelde scorebord wordt hieronder geladen.');const direct=document.createElement('a');direct.href=url;direct.textContent=' Open scorebord ↗';direct.target='_blank';direct.rel='noopener';status.append(direct);document.querySelector('#connection').open=false;try{localStorage.setItem('aos-endpoint',url)}catch{}}\ndocument.querySelector('#link').onclick=()=>connect(document.querySelector('#url').value.trim());if(!live){try{const saved=localStorage.getItem('aos-endpoint');const endpoint=\"https://script.google.com/macros/s/AKfycbx-IQvLhEKweR_7fnkhjODMzUUs3UbmKT2_PHjlhbDSZJEsnU8UrDciGhAsPU33R3I/exec\";if(endpoint){document.querySelector('#url').value=endpoint;connect(endpoint)}}catch{}}window.addEventListener('beforeunload',event=>{if(pending.length){event.preventDefault();event.returnValue=''}});\n</script></body></html>\n\r\n";
// Gekoppeld aan de opgegeven Google Sheet. Gebruik tabblad AoS Scorebord.
const SHEET_ID = '143a0UmHPdKndutN8NJ8dixGCeOJRQaPuKb50I3Caj9Y';
const TAB = 'AoS Scorebord';
function doGet() {
  return HtmlService.createHtmlOutput(AOS_HTML)
    .setTitle('Age of Sigmar · Scorebord')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}
function sheet_() {
  const book = SpreadsheetApp.openById(SHEET_ID);
  let sheet = book.getSheetByName(TAB);
  if (!sheet) {
    sheet = book.insertSheet(TAB);
    sheet.getRange(1, 1, 3, 5).setValues([
      ['Speler', 'Command Points', 'Army Points', 'Victory Points', 'Bijgewerkt'],
      ['Speler 1', 0, 0, 0, ''], ['Speler 2', 0, 0, 0, '']
    ]);
    sheet.setFrozenRows(1);
    sheet.getRange('A1:E1').setFontWeight('bold');
    sheet.autoResizeColumns(1, 5);
  }
  return sheet;
}
function getScores() {
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    const rows = sheet_().getRange(2, 1, 2, 4).getValues();
    return {players: rows.map((r, i) => ({name: String(r[0] || ('Speler ' + (i + 1))),
      command: number_(r[1]), army: number_(r[2]), victory: number_(r[3])}))};
  } finally { lock.releaseLock(); }
}
function number_(value) {
  const n = Number(value);
  if (!Number.isSafeInteger(n) || n < 0 || n > 1000000) throw new Error('Ongeldige score in Sheet. Gebruik een heel getal van 0 tot 1000000.');
  return n;
}
function updateScore(change) {
  if (!change || ![0, 1].includes(change.player)) throw new Error('Ongeldige speler.');
  const columns = {name: 1, command: 2, army: 3, victory: 4};
  if (!Object.prototype.hasOwnProperty.call(columns, change.key)) throw new Error('Ongeldige teller.');
  let value = change.key === 'name' ? String(change.value).trim().slice(0, 60) : number_(change.value);
  if (change.key === 'name' && (!value || /^[=+\-@]/.test(value))) throw new Error('Gebruik een gewone spelersnaam.');
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    const sheet = sheet_();
    sheet.getRange(change.player + 2, columns[change.key]).setValue(value);
    sheet.getRange(change.player + 2, 5).setValue(new Date());
    SpreadsheetApp.flush();
    return {ok: true};
  } finally { lock.releaseLock(); }
}
