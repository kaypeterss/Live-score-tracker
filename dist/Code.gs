function snapshot_(book,tableId){
  const tables=tables_(book);if(!tables.length)throw new Error('Voeg minimaal één actieve tafel toe in AoS Tafels.');
  tables.forEach(t=>{const s=tableSheet_(book,t);t.hasGame=!!s.getRange('B4').getValue();t.battleplan=String(s.getRange('B3').getValue()||'');t.gameId=String(s.getRange('B4').getValue()||'');});
  const table=tables.find(t=>t.id===String(tableId||tables[0].id));if(!table)throw new Error('Deze tafel is niet meer actief. Kies een andere tafel.');
  return {...readTable_(tableSheet_(book,table)),table,tables,catalogs:{armies:choices_(book,'AoS Legers',2),battleplans:choices_(book,'AoS Battleplans',2),tactics:choices_(book,'AoS Battletactics',1)},autoTacticVP:true};
}
function getState(tableId){return withLock_(()=>{const book=SpreadsheetApp.openById(SHEET_ID);initialize_(book);return snapshot_(book,tableId);});}
function applyChange(change){return withLock_(()=>{
  if(!change||typeof change.id!=='string'||!/^[-a-zA-Z0-9]{8,80}$/.test(change.id))throw new Error('Ongeldige wijziging.');
  const book=SpreadsheetApp.openById(SHEET_ID);initialize_(book);const state=snapshot_(book,change.table);const s=tableSheet_(book,state.table),cache=CacheService.getScriptCache(),key='aos-change-'+change.id;
  if(cache.get(key))return state;
  if(String(change.gameId||'')!==state.game.id)throw new Error('Er is inmiddels een ander spel op deze tafel gestart. Vernieuw voordat je verdergaat.');
  if(change.scope==='newGame'){
    choice_(change.battleplan,state.catalogs.battleplans);if(!change.battleplan)throw new Error('Kies een battleplan.');
    if(!Array.isArray(change.players)||change.players.length!==2)throw new Error('Stel beide spelers in.');
    const fresh=blankState_();fresh.game.battleplan=change.battleplan;fresh.game.id=Utilities.getUuid();
    change.players.forEach((p,i)=>{choice_(p.faction,state.catalogs.armies);if(!p.faction)throw new Error('Kies beide legers.');if(!Array.isArray(p.tactics)||p.tactics.length!==2||!p.tactics[0]||!p.tactics[1]||p.tactics[0]===p.tactics[1])throw new Error('Kies per speler twee verschillende battletactics.');p.tactics.forEach(t=>choice_(t,state.catalogs.tactics));fresh.players[i].faction=p.faction;fresh.players[i].tactics=p.tactics.map(name=>({name,goals:[0,0,0]}));fresh.players[i].name=state.players[i].name;});writeTable_(s,fresh);
  }else if(change.scope==='player'){
    if(![0,1].includes(change.player))throw new Error('Ongeldige speler.');const p=state.players[change.player],c=change.player?6:2,rows={command:10,army:11,rage:12,fury:13,victory:14};
    if(rows[change.key]){let value=change.operation==='increment'?(change.key==='victory'?p.baseVictory:p[change.key])+change.delta:Number(change.value);if(change.operation==='increment'){if(![1,-1].includes(change.delta))throw new Error('Ongeldige stap.');value=Math.max(0,value);}else if(change.key==='victory')value-=p.tacticPoints;s.getRange(rows[change.key],c).setValue(number_(value));}
    else if(change.key==='name'){const name=String(change.value).trim();if(!name||name.length>60||/^[=+\-@]/.test(name))throw new Error('Gebruik een gewone spelersnaam.');s.getRange(8,c).setValue(name);}
    else if(change.key==='faction'){choice_(change.value,state.catalogs.armies);s.getRange(9,c).setValue(change.value);}
    else if(change.key==='tactic'){if(![0,1].includes(change.slot))throw new Error('Ongeldige kaart.');choice_(change.value,state.catalogs.tactics);if(change.value&&p.tactics[1-change.slot].name===change.value)throw new Error('Kies twee verschillende battletactics.');if(change.value!==p.tactics[change.slot].name)s.getRange(change.slot?23:17,c,4,1).setValues([[change.value],[0],[0],[0]]);}
    else if(change.key==='goal'){if(![0,1].includes(change.slot)||![0,1,2].includes(change.goal)||!p.tactics[change.slot].name)throw new Error('Kies eerst een battletactic.');s.getRange((change.slot?24:18)+change.goal,c).setValue(points_(change.value));}else throw new Error('Onbekend veld.');
  }else if(change.scope==='game'){
    const g=state.game;
    if(change.key==='battleplan'){choice_(change.value,state.catalogs.battleplans);s.getRange('B3').setValue(change.value);}
    else if(change.key==='active'){if(![0,1,2].includes(Number(change.value)))throw new Error('Ongeldige speler.');s.getRange('F5').setValue(Number(change.value));}
    else if(change.key==='advance'){
      if(g.turn===5&&g.phase==='END')throw new Error('Het spel is afgelopen.');
      let turn=g.turn,phase=g.phase,active=g.active,starter=g.starter;
      if(!turn){if(![1,2].includes(change.starter))throw new Error('Kies wie begint.');turn=1;phase='Top';starter=change.starter;active=starter;}
      else if(phase==='Top'){phase='Bot';active=3-(active||starter||1);}
      else if(phase==='Bot'){phase='END';active=0;}
      else{if(![1,2].includes(change.starter))throw new Error('Kies wie deze turn begint.');turn++;phase='Top';starter=change.starter;active=starter;}
      s.getRange('F3:F5').setValues([[turn],[phase],[active]]);s.getRange('B5').setValue(starter);
    }else throw new Error('Onbekend spelveld.');
  }else throw new Error('Onbekende wijziging.');
  SpreadsheetApp.flush();cache.put(key,'1',21600);return snapshot_(book,change.table);
});}
function choice_(value,list){if(typeof value!=='string'||(value&&!list.includes(value)))throw new Error('Deze optie bestaat niet meer. Vernieuw de lijsten.');}
