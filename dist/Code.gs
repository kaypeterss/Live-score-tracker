const AOS_HTML = "<!doctype html>\n<html lang=\"nl\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Age of Sigmar · Scorebord</title><meta name=\"description\" content=\"Scorebord voor twee spelers voor General’s Handbook 2026–27, gekoppeld aan Google Sheets.\"><link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23121b25'/%3E%3Ctext x='32' y='45' text-anchor='middle' font-size='42' fill='%23ddba72'%3E⚔%3C/text%3E%3C/svg%3E\"><style>\n:root{color-scheme:dark;font-family:system-ui,sans-serif;background:#101720;color:#eeeae2;--gold:#e1bd7d}*{box-sizing:border-box}body{margin:0}main{max-width:1180px;margin:auto;padding:24px}header{display:flex;justify-content:space-between;align-items:center;gap:16px;border-bottom:1px solid #34404d;padding-bottom:18px}.eyebrow{font-size:14px;color:var(--gold);letter-spacing:.15em;font-weight:700}h1{font:normal 32px Georgia,serif;margin:6px 0}h2{font:normal 23px Georgia,serif;margin:0}h3{font-size:16px;margin:0 0 16px;color:#d5c8b0}a{color:var(--gold)}button,input,select{font:inherit}button{border:1px solid #48586a;background:#253443;color:#edf0f3;border-radius:7px;min-height:44px;cursor:pointer;padding:8px 13px}button:hover{background:#34485b}button:disabled{opacity:.45;cursor:default}button[aria-pressed=true]{border-color:var(--gold);background:#4a3f2b;color:#ffe0a4}input,select{color:#eee;background:#101c27;border:1px solid #47586a;border-radius:7px;min-height:44px;padding:8px 10px;min-width:0}button:focus-visible,a:focus-visible,select:focus,input:focus{outline:2px solid var(--gold);outline-offset:3px}label{font-size:14px;color:#b9c8d6;display:block;margin-bottom:8px}.statusline{display:flex;align-items:center;gap:12px;justify-content:space-between;min-height:56px;margin:4px 0}#status{font-size:14px;color:#b9c5d1;line-height:1.5;margin:0}#status.error{color:#ffa69d}.actions{display:flex;gap:8px}.actions button{font-size:14px;white-space:nowrap}.game{display:grid;grid-template-columns:1.1fr 1fr;gap:22px;background:#16212d;border:1px solid #354456;border-radius:10px;padding:20px;margin-bottom:22px}.game select{width:100%}.turnrow,.phases,.activebuttons{display:flex;gap:8px;flex-wrap:wrap}.turnrow button{min-width:44px}.phases{margin-top:10px}.phases button{flex:1}.game-note{color:#91a5b8;font-size:14px;margin:10px 0 0}.players{display:grid;grid-template-columns:1fr 1fr;gap:22px}.player{--accent:#82b7e5;background:#18232f;border:1px solid #384757;border-top:3px solid var(--accent);border-radius:12px;padding:22px}.player:nth-child(2){--accent:#e5a27c}.player.active{box-shadow:0 0 0 2px var(--accent)}.playerhead{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}.name{border:0;background:transparent;color:var(--accent);font:normal 27px Georgia,serif;width:100%;padding:5px 0}.activebtn{font-size:14px;white-space:nowrap}.activebtn[aria-pressed=true]{color:var(--accent);background:#253443;border-color:var(--accent)}.faction{width:100%;margin-bottom:18px}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:12px}.metric{background:#14202c;border:1px solid #334253;border-radius:8px;padding:13px}.metric-label{font-size:14px;color:#bacbdc;margin-bottom:9px;display:flex;justify-content:space-between}.metric-label small{font-size:14px;color:#728ba3}.counter{display:flex;gap:8px;align-items:center}.counter button{padding:0;width:42px;height:44px;flex-shrink:0;font-size:25px}.value{border:0;background:transparent;padding:0;text-align:center;font-size:32px;font-weight:650;font-variant-numeric:tabular-nums;width:100%;appearance:textfield}.value::-webkit-inner-spin-button{appearance:none}.metric.victory{grid-column:1/-1;border-color:#645439}.victory .value{color:var(--gold);font-size:38px}.vpnote{font-size:14px;color:#ae9e7e;margin:9px 0 0;text-align:center}.tactics{border-top:1px solid #354454;margin-top:22px;padding-top:20px}.tactic{border:1px solid #384b5b;border-radius:8px;padding:14px;margin-top:14px}.tactichead{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:10px}.tactichead label{margin:0}.subtotal{color:var(--gold);font-size:14px;white-space:nowrap}.tactic select{width:100%}.goals{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}.goal{display:flex;flex-direction:column;align-items:center;gap:4px;padding:10px 6px;font-size:14px}.goal strong{font-size:18px}.tactic-note{color:#94a9bd;font-size:14px;line-height:1.5;margin:12px 0 0}details{border:1px solid #364758;border-radius:8px;margin-top:24px;padding:16px;color:#b4c5d6;line-height:1.7}summary{cursor:pointer;font-size:16px;color:#d6bd92}details p{font-size:16px}details li{font-size:14px;margin:8px 0}#remote{display:none;width:100%;border:0;height:1600px}body.hosted main{max-width:none;padding:0 12px;margin:0}body.hosted header,body.hosted #workspace,body.hosted details,body.hosted #refresh{display:none}body.hosted #remote{display:block}body.hosted .statusline{justify-content:flex-start;padding:8px 12px}body.hosted #status{color:#9cafc2}body.hosted #retry{display:none}.sheet-link{font-size:14px;white-space:nowrap}.disabled{opacity:.6}@media(max-width:760px){main{padding:18px 14px}.game{grid-template-columns:1fr;gap:18px}.players{gap:12px;grid-template-columns:1fr}.player{padding:14px 12px}.metrics{gap:8px}.counter{gap:4px}.counter button{width:34px}.metric{padding:10px 8px}.value{font-size:27px}.metric-label small{display:none}.playerhead{flex-wrap:wrap}.activebtn{width:100%}.name{font-size:24px}.goals{gap:5px}.goal{font-size:14px;padding:9px 2px}.statusline{align-items:flex-start;flex-wrap:wrap;padding:12px 0}.actions button{font-size:14px}h1{font-size:27px}.game{padding:16px}}@media(max-width:550px){.players{grid-template-columns:1fr}.activebtn{width:auto}.playerhead{flex-wrap:nowrap}.name{max-width:70%}.metric-label{font-size:16px}.goal{font-size:14px}.counter button{width:44px}.value{font-size:34px}.sheet-link{white-space:normal;text-align:right}}\n[hidden]{display:none!important}.lobby{max-width:760px;margin:30px auto;background:#18232f;border:1px solid #48586a;padding:26px;border-radius:12px}.lobby h2{margin-bottom:16px}.lobby select{width:100%;margin-bottom:16px}.lobby p{line-height:1.6;color:#b9c8d6}.primary{background:#715a31;border-color:#e1bd7d;font-weight:650}.lobby-actions{display:flex;gap:12px;flex-wrap:wrap}.setup-players{display:grid;grid-template-columns:1fr 1fr;gap:20px}.setup-players fieldset{border:1px solid #48586a;border-radius:8px;padding:14px}.turn-display{font-size:30px;font-weight:700;color:var(--gold);margin-bottom:12px}.turn-actions{display:flex;gap:10px;flex-wrap:wrap}.turn-actions .primary{flex:1}.tablebar{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}dialog{background:#18232f;color:#eeeae2;border:1px solid #e1bd7d;border-radius:12px;max-width:90vw}dialog::backdrop{background:#000a}.starter-buttons{display:flex;gap:12px}@media(max-width:600px){.setup-players{grid-template-columns:1fr}.lobby{padding:18px;margin:15px auto}.turn-display{font-size:26px}}body.hosted #lobby,body.hosted #setup,body.hosted dialog{display:none}</style></head><body><main><header><div><div class=\"eyebrow\">AGE OF SIGMAR · 2026–27</div><h1>Het slagveld in cijfers</h1></div><a class=\"sheet-link\" href=\"https://docs.google.com/spreadsheets/d/143a0UmHPdKndutN8NJ8dixGCeOJRQaPuKb50I3Caj9Y/edit\" target=\"_blank\" rel=\"noopener\">Open Google Sheet ↗</a></header><div class=\"statusline\"><p id=\"status\" role=\"status\" aria-live=\"polite\">Scores ophalen uit Google Sheet…</p><div class=\"actions\"><button id=\"retry\" hidden>Opnieuw proberen</button><button id=\"refresh\">Lijsten vernieuwen</button></div></div><section id=\"lobby\" class=\"lobby\" hidden><h2>Waar spelen jullie?</h2><label for=\"tableChoice\">Tafel</label><select id=\"tableChoice\"></select><p id=\"tableSummary\"></p><div class=\"lobby-actions\"><button id=\"continueGame\" class=\"primary\">Bestaand spel verder spelen</button><button id=\"newGame\">Nieuw spel</button></div></section><form id=\"setup\" class=\"lobby\" hidden><h2>Nieuw spel · <span id=\"setupTable\"></span></h2><label for=\"setupPlan\">Battleplan *</label><select id=\"setupPlan\" required></select><div class=\"setup-players\" id=\"setupPlayers\"></div><p>Alle scores starten op 0, Command Points op 4. De turn begint op ‘-’.</p><div class=\"lobby-actions\"><button class=\"primary\" type=\"submit\">Spel starten</button><button type=\"button\" id=\"cancelSetup\">Terug</button></div></form><dialog id=\"starterDialog\"><h2>Wie begint deze turn?</h2><p>Deze speler wordt de actieve speler bij Top.</p><div id=\"starterButtons\" class=\"starter-buttons\"></div><button id=\"cancelStarter\">Annuleren</button></dialog><div id=\"workspace\" hidden><div class=\"tablebar\"><h2 id=\"tableTitle\"></h2><button id=\"changeTable\">Andere tafel / spel</button></div><section class=\"game\" aria-label=\"Instellingen voor beide spelers\"><div><label for=\"battleplan\">Battleplan · voor beide spelers</label><select id=\"battleplan\" disabled><option>Kies een battleplan</option></select><p class=\"game-note\" id=\"activeLabel\"></p></div><div><div class=\"turn-display\" id=\"turnlabel\">-</div><div class=\"turn-actions\"><button class=\"primary\" id=\"nextTurn\">Volgende fase →</button></div></div></section><section class=\"players\" aria-label=\"Scores voor twee spelers\"></section></div><iframe id=\"remote\" title=\"Scorebord gekoppeld aan Google Sheets\"></iframe><details><summary>Keuzelijsten en gegevens beheren in Google Sheets</summary><p>Voeg een naam toe op een nieuwe rij in de Sheet. Nieuwe opties verschijnen automatisch in de app, of direct via ‘Lijsten vernieuwen’.</p><ul><li><strong>AoS Legers:</strong> naam in kolom A, alliantie in B. Actief in C; een lege cel telt als actief.</li><li><strong>AoS Battleplans:</strong> naam in A, tabel in B. Actief in C.</li><li><strong>AoS Battletactics:</strong> naam in A. Actief in B.</li><li><strong>AoS Tafels:</strong> voeg een rij toe met een uniek ID in A, een tafelnaam in B en Actief in C. Elke tafel krijgt automatisch een eigen spelblad.</li><li><strong>Spel · ID:</strong> de spelers staan naast elkaar. Pas scores, legers, battletactics en doelen (0 of 5) direct op dit blad aan. Overige VP en totaal staan apart.</li><li><strong>AoS Scorebord (archief):</strong> scores, leger en twee battletactics per speler. Doelen zijn 0 of 5. Bewerk overige Victory Points in kolom D; battletactic-punten en het volledige totaal staan in Q en R.</li><li><strong>AoS Spel (archief):</strong> gezamenlijk battleplan, actieve speler (0, 1 of 2), turn (0–5) en fase (-, Top, Bot, END).</li></ul><p>Vink ‘Actief’ uit om een optie te verbergen. Bestaande selecties blijven herkenbaar totdat je zelf een andere keuze maakt.</p><p class=\"tactic-note\">Battleplans: <a href=\"https://aosmissions.app/battleplans\" target=\"_blank\" rel=\"noopener\">AoS Missions · General’s Handbook 2026–27</a>. Legers: <a href=\"https://www.warhammer-community.com/en-gb/articles/yqfizsmh/prepare-for-the-new-generals-handbook-with-scourge-of-aqshy/\" target=\"_blank\" rel=\"noopener\">Warhammer Community · Scourge of Aqshy</a>. De bron van elke optie staat ook in de Sheet.</p></details></main><script>\nconst metrics=[['Command Points','CP','command'],['Army Points','AP','army'],['Rage Dice','RD','rage'],['Fury Level','FL','fury'],['Victory Points','VP','victory']];\nconst goalNames=['Affray','Strike','Domination'];const live=typeof google!=='undefined'&&google.script&&google.script.run;\nlet selectedTable='',screen='lobby';\nlet confirmed=null,view=null,pending=[],busy=false,failed=false,loading=false,refreshing=false,renderDeferred=false,mutationVersion=0;\nconst status=document.querySelector('#status'),retry=document.querySelector('#retry');\nfunction message(text,error=false){status.textContent=text;status.classList.toggle('error',error)}\nfunction total(p){p.tacticPoints=p.tactics.reduce((n,t)=>n+t.goals.reduce((a,b)=>a+b,0),0);p.victory=p.baseVictory+(view.autoTacticVP?p.tacticPoints:0)}\nfunction project(){view=JSON.parse(JSON.stringify(confirmed));for(const c of pending){if(c.scope==='newGame'||c.key==='advance')continue;if(c.scope==='game'){if(c.key==='turn'){view.game.turn=c.turn;view.game.phase=c.phase}else view.game[c.key]=c.value}else{const p=view.players[c.player];if(c.key==='goal')p.tactics[c.slot].goals[c.goal]=c.value;else if(c.key==='tactic'){if(p.tactics[c.slot].name!==c.value)p.tactics[c.slot]={name:c.value,goals:[0,0,0]}}else if(c.key==='victory'){p.baseVictory=c.operation==='increment'?p.baseVictory+c.delta:c.value-(view.autoTacticVP?p.tacticPoints:0)}else if(c.operation==='increment')p[c.key]+=c.delta;else p[c.key]=c.value;total(p)}}view.players.forEach(total)}\nfunction enqueue(change){if(!confirmed)return;mutationVersion++;change.id=crypto.randomUUID();change.table=selectedTable;change.gameId=confirmed.game.id;pending.push(change);project();render();message('Opslaan in Google Sheet…');pump()}\nfunction renderWhenSafe(){if(['INPUT','SELECT'].includes(document.activeElement.tagName))renderDeferred=true;else render()}\nfunction pump(){if(busy||failed||!pending.length)return;busy=true;google.script.run.withSuccessHandler(data=>{const done=pending.shift();confirmed=data;if(done.scope==='newGame')screen='play';busy=false;project();renderWhenSafe();if(pending.length)pump();else message('Opgeslagen in Google Sheet · '+new Date().toLocaleTimeString('nl-NL',{hour:'2-digit',minute:'2-digit'}))}).withFailureHandler(error=>{busy=false;failed=true;retry.hidden=false;message('Opslaan mislukt: '+(error.message||'controleer je verbinding')+' Je wijziging staat nog klaar.',true)}).applyChange(pending[0])}\nfunction fetchState(manual=false){if(!live||busy||pending.length||refreshing)return;const version=mutationVersion;refreshing=true;if(manual)message('Scores en lijsten vernieuwen…');google.script.run.withSuccessHandler(data=>{refreshing=false;if(version!==mutationVersion)return;confirmed=data;selectedTable=data.table.id;project();renderWhenSafe();if(manual||loading){loading=false;message('Gekoppeld aan Google Sheet · wijzigingen worden automatisch opgeslagen.')}}).withFailureHandler(error=>{refreshing=false;if(version!==mutationVersion)return;loading=false;message('Ophalen mislukt: '+(error.message||'controleer je verbinding'),true);retry.hidden=false}).getState(selectedTable)}\nretry.onclick=()=>{retry.hidden=true;if(pending.length){failed=false;pump()}else fetchState(true)};document.querySelector('#refresh').onclick=()=>fetchState(true);\ndocument.addEventListener('focusout',()=>setTimeout(()=>{if(renderDeferred&&!['INPUT','SELECT'].includes(document.activeElement.tagName)){renderDeferred=false;render()}},0));\nfunction options(select,names,selected,placeholder,exclude=''){select.replaceChildren();const first=new Option(placeholder,'');select.append(first);for(const name of names){const option=new Option(name,name);option.disabled=!!exclude&&name===exclude;select.append(option)}if(selected&&!names.includes(selected)){select.append(new Option(selected+' · niet in actieve lijst',selected))}select.value=selected;select.disabled=false}\nfunction button(text,label,fn,pressed){const el=document.createElement('button');el.textContent=text;el.setAttribute('aria-label',label);if(pressed!==undefined)el.setAttribute('aria-pressed',pressed?'true':'false');el.onclick=fn;return el}\nfunction render(){if(!view)return;renderScreen();if(screen!=='play')return;const game=view.game;document.querySelector('#tableTitle').textContent=view.table.name;options(document.querySelector('#battleplan'),view.catalogs.battleplans,game.battleplan,'Kies een battleplan');document.querySelector('#battleplan').onchange=e=>enqueue({scope:'game',key:'battleplan',value:e.target.value});document.querySelector('#turnlabel').textContent=game.turn?'Turn '+game.turn+' / 5 · '+game.phase:'- · Nog niet begonnen';document.querySelector('#activeLabel').textContent=game.active?'Actieve speler: '+view.players[game.active-1].name:'Geen actieve speler';const next=document.querySelector('#nextTurn');next.disabled=busy||pending.length>0||(game.turn===5&&game.phase==='END');next.textContent=!game.turn?'Start turn 1 →':game.phase==='Top'?'Volgende fase · Bot →':game.phase==='Bot'?'Sluit turn af · END →':game.turn===5?'Spel afgelopen':'Start turn '+(game.turn+1)+' →';next.onclick=()=>advance();const root=document.querySelector('.players');root.replaceChildren();view.players.forEach((p,i)=>{const card=document.createElement('article');card.className='player'+(game.active===i+1?' active':'');const head=document.createElement('div');head.className='playerhead';const name=document.createElement('input');name.className='name';name.value=p.name;name.maxLength=60;name.setAttribute('aria-label','Naam speler '+(i+1));name.onchange=()=>{const value=name.value.trim();if(!value||/^[=+\\-@]/.test(value)){name.value=p.name;message('Gebruik een gewone spelersnaam.',true);return}enqueue({scope:'player',player:i,key:'name',value})};head.append(name,button(game.active===i+1?'Actieve speler':'Maak actief','Speler '+(i+1)+' actief maken',()=>enqueue({scope:'game',key:'active',value:game.active===i+1?0:i+1}),game.active===i+1));head.lastChild.className='activebtn';card.append(head);const faction=document.createElement('select');faction.className='faction';faction.setAttribute('aria-label','Leger speler '+(i+1));options(faction,view.catalogs.armies,p.faction,'Kies een leger');faction.onchange=()=>enqueue({scope:'player',player:i,key:'faction',value:faction.value});card.append(faction);const grid=document.createElement('div');grid.className='metrics';metrics.forEach(([label,short,key])=>{const row=document.createElement('div');row.className='metric'+(key==='victory'?' victory':'');const title=document.createElement('div');title.className='metric-label';title.innerHTML='<span>'+label+'</span><small>'+short+'</small>';const counter=document.createElement('div');counter.className='counter';const value=document.createElement('input');value.className='value';value.type='number';const floor=key==='victory'&&view.autoTacticVP?p.tacticPoints:0;value.min=floor;value.max=1000000;value.step=1;value.value=p[key];value.setAttribute('aria-label',label+' speler '+(i+1));const minus=button('−',label+' verlagen voor speler '+(i+1),()=>enqueue({scope:'player',player:i,key,operation:'increment',delta:-1}));minus.disabled=p[key]<=floor;const plus=button('+',label+' verhogen voor speler '+(i+1),()=>enqueue({scope:'player',player:i,key,operation:'increment',delta:1}));plus.disabled=(key==='victory'?p.baseVictory:p[key])>=1000000;value.onchange=()=>{const n=Number(value.value);if(!Number.isSafeInteger(n)||n<floor||n>1000000){value.value=p[key];message('Voer een geldig geheel getal in'+(floor?' (minimaal '+floor+' door je battletactics)':'')+'.',true);return}enqueue({scope:'player',player:i,key,value:n})};counter.append(minus,value,plus);row.append(title,counter);if(key==='victory'){const note=document.createElement('p');note.className='vpnote';note.textContent=p.baseVictory+' overige VP'+(view.autoTacticVP?' + '+p.tacticPoints+' battletactic VP':' · '+p.tacticPoints+' battletactic-punten apart');row.append(note)}grid.append(row)});card.append(grid);const tactics=document.createElement('section');tactics.className='tactics';const heading=document.createElement('h3');heading.textContent='Battletactics · '+p.tacticPoints+' / 30 punten';tactics.append(heading);p.tactics.forEach((t,slot)=>{const box=document.createElement('div');box.className='tactic';const top=document.createElement('div');top.className='tactichead';const lbl=document.createElement('label');lbl.htmlFor='tactic-'+i+'-'+slot;lbl.textContent='Battletactic '+(slot+1);const subtotal=document.createElement('span');subtotal.className='subtotal';subtotal.textContent=t.goals.reduce